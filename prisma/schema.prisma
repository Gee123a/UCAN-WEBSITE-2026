datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Rsvp {
  id           String   @id @default(uuid())
  name         String
  nim          String   @unique
  major        String
  organization String
  createdAt    DateTime @default(now())
}
